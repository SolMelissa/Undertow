__pycache__/
*.pyc
*.stackdump
.venv/

# IDE
.vscode/

# Claude Code worktrees
.claude/worktrees/

# Build output / packaged binaries
*.exe
*.exe.WebView2/
launcher/bin/
launcher/obj/

# Runtime state for the girly-mode image gallery's usage-balancing (see _anime_pick() in
# undertow/webui.py) - regenerated automatically, not something to track in source control.
undertow/static/images/anime/.gallery_stats.json

# tag_cleanup.py's local HTML dry-run reports - regenerated fresh every run, not app assets.
undertow/scripts/output/

# User-dropped girly-mode gallery images themselves aren't tracked (they're the user's own
# pictures, not app assets) - only the README explaining the folder is.
undertow/static/images/anime/*
!undertow/static/images/anime/README.md

# Deprecated hacker/terminal-mode dashboard partials - girly mode is now the default and only
# mode under active development. These are the non-girly counterparts _themed_template() in
# webui.py used to pick between (see undertow/templates/partials/girly/ for the ones
# still in use); the #hacker-view UI that rendered them is no longer reachable from index.html.
undertow/templates/partials/fleet.html
undertow/templates/partials/hoststats.html
undertow/templates/partials/netstat.html
undertow/templates/partials/queue_graph.html
undertow/templates/partials/status.html
undertow/templates/partials/subs_table.html
